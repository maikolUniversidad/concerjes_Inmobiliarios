{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "APP_BASE_URL",
        "RONDA_HMAC_LLAVE_ACTUAL",
        "RONDA_HMAC_*",
        "RONDA_SESION_SECRETO",
        "PQRS_IP_SALT",
        "CRON_SECRET",
        "WHATSAPP_APP_ID",
        "WHATSAPP_APP_SECRET",
        "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
        "WHATSAPP_TOKEN_LLAVE",
        "WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID",
        "WHATSAPP_EMBEDDED_SIGNUP_FEATURE_TYPE",
        "WHATSAPP_GRAPH_BASE_URL",
        "WHATSAPP_API_VERSION",
        "WHATSAPP_BSP_BASE_URL",
        "WHATSAPP_BSP_API_KEY",
        "WHATSAPP_THROUGHPUT_MPS",
        "WHATSAPP_VENTANA_SEGURIDAD_HORAS",
        "WHATSAPP_JORNADA_FALLBACK",
        "WHATSAPP_ZONA_HORARIA",
        "WHATSAPP_BUCKET_EVIDENCIA",
        "WHATSAPP_SIMULADOR",
        "FACIAL_SERVICE_URL",
        "FACIAL_SERVICE_TOKEN",
        "FACIAL_UMBRAL_MATCH",
        "FACIAL_UMBRAL_DUDA",
        "FACIAL_LIVENESS_MIN",
        "OPENAI_API_KEY",
        "OPENAI_MODEL_CHAT",
        "OPENAI_MODEL_VISION",
        "OPENAI_MODEL_TRANSCRIBE",
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DEEPSEEK_MODEL_CHAT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ]
    }
  }
}
