# ============================================
# VERCEL (solo en CI/CD)
# ============================================
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID_WEB=""
VERCEL_PROJECT_ID_INVENTARIO=""

# ============================================
# PUNTOS QR — firma del código (ADR-B)
# Una llave por cliente y versionada. El secreto NUNCA va a la base de datos:
# en `ronda_qr.firma_llave_id` solo queda cuál se usó, para que rotar la llave
# no invalide las placas ya impresas. El nombre de la variable sale del id de la
# llave en mayúsculas con guiones bajos: cli-demo-v1 → RONDA_HMAC_CLI_DEMO_V1.
# ============================================
RONDA_HMAC_LLAVE_ACTUAL="cli-demo-v1"
RONDA_HMAC_CLI_DEMO_V1="cambiar-esto-por-un-secreto-largo-y-aleatorio"

# Firma de la cookie de /campo (quien trabaja sin cuenta, con enlace + PIN).
# Mínimo 16 caracteres. Si falta, se deriva de SUPABASE_SERVICE_ROLE_KEY.
RONDA_SESION_SECRETO="cambiar-esto-por-otro-secreto-largo-y-aleatorio"

# Sal del `ip_hash` de las PQRS que se radican desde el QR de un punto (F5).
# Se guarda SHA-256(sal|ip) y nunca la IP, que es dato personal (Ley 1581):
# alcanza para limitar envíos por hora. Si falta, se usa la llave de firma del
# QR; si tampoco hay, se radica igual con ip_hash NULL y solo protege el límite
# por punto. Nunca una sal fija en el repositorio: con IPv4 sería reversible.
PQRS_IP_SALT="cambiar-esto-por-otro-secreto-largo-y-aleatorio"

# ============================================
# PUNTOS QR — bot de WhatsApp (F9, ADR-01)
#
# Acá viven SOLO los secretos de la APP de Meta, que son los mismos para todos
# los clientes. El `waba_id`, el `phone_number_id` y los tokens de la empresa NO
# van acá: son por cliente, se obtienen en tiempo de ejecución cuando termina
# Embedded Signup y viven en `whatsapp_cuentas` / `whatsapp_credenciales`.
#
# REGLA DE ORO: si falta esta configuración, TODO funciona menos el envío real.
# El webhook recibe (firmado localmente), la máquina de estados corre, la
# evidencia se guarda y el simulador deja ver cada mensaje tal como saldría.
#
# Todos los valores de abajo son DE EJEMPLO.
# ============================================
WHATSAPP_APP_ID="1234567890123456"
# Con esto Meta firma X-Hub-Signature-256, y es el ÚNICO control de
# autenticidad del webhook. Sin esta variable el endpoint rechaza TODO: un
# despliegue al que le falta no es un despliegue permisivo.
WHATSAPP_APP_SECRET="00000000000000000000000000000000"
# La cadena que se devuelve en el reto de suscripción. Si no cuadra, Meta no
# entrega NINGÚN webhook y el síntoma es «no llegan mensajes», sin ningún error.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="cambie-esto-por-algo-aleatorio-de-48-chars"
# Llave con la que se cifran los tokens de Meta antes de guardarlos (AES-256-GCM).
# Mínimo 32 caracteres. Sin ella no se pueden leer ni guardar, y guardarlos en
# claro no es una opción.
WHATSAPP_TOKEN_LLAVE="cambiar-esto-por-un-secreto-de-al-menos-32-caracteres"
# Embedded Signup. Sin el config id la pantalla de conexión dice «Sin
# configurar» en vez de romperse. Las versiones 2 y 3 quedan obsoletas el
# 15 de octubre de 2026: al implementar hay que confirmar el valor de la v4.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID="987654321098765"
WHATSAPP_EMBEDDED_SIGNUP_FEATURE_TYPE="whatsapp_business_app_onboarding"
# Graph API. Es CONFIGURACIÓN y no una constante: las versiones duran unos dos
# años, así que se revisa el changelog cada trimestre.
WHATSAPP_GRAPH_BASE_URL="https://graph.facebook.com"
WHATSAPP_API_VERSION="v26.0"

# Transporte por proveedor oficial (BSP), cuando la cuenta dice `BSP`.
WHATSAPP_BSP_BASE_URL="https://ejemplo-bsp.invalid/v1"
WHATSAPP_BSP_API_KEY="bsp-llave-de-ejemplo"

# Operación.
# El tope del número en coexistencia es 20 mensajes por segundo y NO se puede
# subir: acá va el tope propio, por debajo, para dejar margen.
WHATSAPP_THROUGHPUT_MPS="15"
# Margen sobre la ventana de 24 h de Meta. Tomarla justa es garantizar que el
# mensaje encolado en el minuto 1.439 llegue tarde.
WHATSAPP_VENTANA_SEGURIDAD_HORAS="23"
# Franja de respaldo cuando el contrato no tiene jornada de mensajería
# (`grupo_reglas.mensajeria_desde/hasta`). Es una red de seguridad, no una
# política: lo correcto es que haya turno.
WHATSAPP_JORNADA_FALLBACK="06:00-20:00"
WHATSAPP_ZONA_HORARIA="America/Bogota"
WHATSAPP_BUCKET_EVIDENCIA="rondas"
# 1 = nada sale hacia un teléfono y se habilita /api/whatsapp/simulador.
WHATSAPP_SIMULADOR="0"
