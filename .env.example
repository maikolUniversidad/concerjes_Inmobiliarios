# URL base que usan las API routes para armar enlaces absolutos.
APP_BASE_URL="https://inventario.conserjesinmobiliarios.com"

# Secreto del cron de Vercel. Si está definido, /api/cron/* exige
# Authorization: Bearer <CRON_SECRET>. Vercel lo envía automáticamente.
# Lo usan /api/cron/correo (buzón de salida) y /api/cron/flujos (motor de
# notificaciones), ambos cada 5 minutos según vercel.json.
CRON_SECRET=""

# OAuth del correo (Google / Microsoft): el Client ID y el Client Secret se
# guardan por cuenta desde /integraciones/correo, no aquí. Lo único que debe
# coincidir es la URL de redirección que se registra en la consola del
# proveedor, que se arma con APP_BASE_URL:
#   <APP_BASE_URL>/api/integraciones/correo/oauth/callback

