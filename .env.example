FACIAL_SERVICE_URL="https://[servicio-facial]"
FACIAL_SERVICE_TOKEN=""
FACIAL_UMBRAL_MATCH="0.65"
FACIAL_UMBRAL_DUDA="0.55"
FACIAL_LIVENESS_MIN="0.7"

# ============================================
# APP MÓVIL / ESCRITORIO (Vite — apps/movil)
