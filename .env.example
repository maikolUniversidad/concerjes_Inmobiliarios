VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# ============================================
# EMAIL (Alertas y notificaciones)
# ============================================
RESEND_API_KEY="re_..."
EMAIL_FROM="inventario@conserjesinmobiliarios.com"
